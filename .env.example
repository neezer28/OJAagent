# Copy this file to .env.local and fill in your own values.
# Never commit real keys. .env.local is git-ignored.

# Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Telegram ID of the shop owner (send /whoami to the bot to find yours)
OWNER_TELEGRAM_ID=

# Supabase: project URL and the secret (service role) key
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NEAR Intents: asset ID of USDC on the NEAR chain, and the account that receives payments
NEAR_USDC_ASSET_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
MERCHANT_NEAR_ACCOUNT=

# NEAR AI Cloud (optional: without it the bot still answers /commands)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Demo exchange rate, naira per US dollar (a placeholder, not a live rate)
NGN_PER_USD=1500